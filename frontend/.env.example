# Where the FastAPI service lives. Used at build and run time by the /api rewrite in next.config.ts.
BACKEND_URL=http://127.0.0.1:8000

# Optional: turn on Google Maps. Leave empty to use OpenStreetMap.
# This is a BROWSER key and is visible to every visitor by design. In Google Cloud Console,
# enable "Maps JavaScript API" and restrict the key to your site's HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
