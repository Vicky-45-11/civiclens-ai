# Copy to .env (never commit .env). Every value here is read by app/config.py.
APP_ENV=development                 # anything other than "development" requires a real JWT_SECRET
DATABASE_URL=postgresql+psycopg://civiclens:civiclens@localhost:5432/civiclens
JWT_SECRET=dev-only-change-me-dev-only-change-me   # use 32+ random characters outside development
COOKIE_SECURE=false                 # set true behind HTTPS
CORS_ORIGINS=http://localhost:3000  # comma separated; only needed if the browser calls the API directly

# Object storage: "local" (STORAGE_DIR) or "s3" (any S3-compatible service; the S3 path is untested)
STORAGE_BACKEND=local
STORAGE_DIR=./storage
S3_ENDPOINT_URL=
S3_BUCKET=civiclens
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

MAX_UPLOAD_BYTES=6291456
MAX_PHOTOS_PER_ISSUE=4

# Path to a checkpoint produced by `python -m app.ai.train`. Empty = demo mode (no AI classification).
MODEL_PATH=
DUPLICATE_RADIUS_M=60
DUPLICATE_PHASH_DISTANCE=10

RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_SUBMIT_PER_MIN=6
RATE_LIMIT_WRITE_PER_MIN=40
RATE_LIMIT_READ_PER_MIN=240

# Optional: create the first admin at startup if this email does not exist yet (password >= 12 chars).
ADMIN_EMAIL=
ADMIN_PASSWORD=
